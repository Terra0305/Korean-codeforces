# Django 설정
# 이 파일을 복사하여 .env 파일을 생성하고 값을 채워주세요.
# cp .env.example .env

# 새 SECRET_KEY 생성 방법:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='django-insecure-sc&%-5w7xk6x+dteu$qq1olf2*_$-)&-k(kug-#kq=ultq0i1*'

# 프로덕션: False, 개발: True
DEBUG=False

# 허용 호스트 (쉼표 구분)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS 추가 허용 출처 (필요 시, 쉼표 구분)
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# CSRF 추가 신뢰 출처 (필요 시, 쉼표 구분)
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
